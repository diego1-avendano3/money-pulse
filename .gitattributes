# Normalize line endings: LF in the repo, native on checkout only where required.
* text=auto eol=lf

# Scripts that must keep their platform endings
*.bat        text eol=crlf
*.cmd        text eol=crlf
gradlew      text eol=lf
*.sh         text eol=lf

# Binary — never diff or convert
*.jar        binary
*.png        binary
*.jpg        binary
*.gif        binary
*.ico        binary
*.woff2      binary

# Keep Gradle wrapper jar in the repo (see .gitignore negation)
gradle/wrapper/gradle-wrapper.jar binary
